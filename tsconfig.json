{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ES2022",
		"noImplicitReturns": true,
		"moduleResolution": "bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"noUncheckedIndexedAccess": true,
		"isolatedModules": true,
		"strict": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"types": ["node"],
		"lib": [
			"DOM",
			"ES2022"
		]
	},
	"include": [
		"src/**/*.ts"
	]
}
