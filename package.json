{
	"name": "obsidian-vault-backup",
	"version": "0.3.0",
	"description": "Create local ZIP backups of your Obsidian vault with automatic retention management",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "node scripts/test.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --max-warnings=0",
		"check": "npm run lint && npm test && npm run build"
	},
	"engines": {
		"node": "^22.13.0 || >=24.0.0"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@eslint/js": "9.39.5",
		"@types/archiver": "8.0.0",
		"@types/node": "18.19.130",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-plugin-obsidianmd": "0.4.2",
		"globals": "17.13.0",
		"moment": "2.31.0",
		"obsidian": "1.14.4",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"yauzl": "3.4.0"
	},
	"dependencies": {
		"archiver": "8.0.0"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"moment": "$moment"
		}
	}
}
